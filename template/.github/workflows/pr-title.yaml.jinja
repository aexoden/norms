# SPDX-FileCopyrightText: {{ copyright_year }} {{ author_name }} <{{ author_email }}>

name: Pull Request Title

# A pull request's title becomes the subject of its squash merge, so it's checked
# when the pull request opens and whenever the title is edited. This workflow is
# separate from CI, so editing a pull request doesn't rerun CI, and the gate job
# doesn't depend on it.
on:
  pull_request:
    types: [opened, reopened, edited]

# Runs for edits that leave the title alone do nothing, so each gets a group of
# its own rather than cancelling a check of the title in progress.
concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}${{ github.event.action == 'edited' && !github.event.changes.title && format('-{0}', github.run_id) || '' }}{% endraw %}
  cancel-in-progress: true

permissions: {}

jobs:
  pr-title:
    name: Check the pull request title
    if: github.event.action != 'edited' || github.event.changes.title
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read
    steps:
      - name: Checkout repository
        uses: actions/checkout@{{ action_checkout }}
        with:
          persist-credentials: false

      - name: Install uv
        uses: astral-sh/setup-uv@{{ action_setup_uv }}
        with:
          enable-cache: false

      # The squash merge's subject is the title followed by the pull request's number. The hooks
      # pass autosquash and merge subjects, which a squash merge keeps, so they're rejected first.
      # GIT_EDITOR=: tells norms, as git does, that the message wasn't edited, so a title starting
      # with git's comment character is checked as GitHub keeps it rather than left out.
      # pre-commit builds norms with the runner's Rust.
      - name: Run the commit-msg hooks on the squash merge's subject
        env:
          GIT_EDITOR: ":"
          PR_NUMBER: {% raw %}${{ github.event.pull_request.number }}{% endraw %}
          PR_TITLE: {% raw %}${{ github.event.pull_request.title }}{% endraw %}
        run: |
          case "$PR_TITLE" in
            'fixup! '* | 'squash! '* | 'amend! '* | Merge*)
              echo "::error::The title is an autosquash or merge subject, not a conventional commit subject."
              exit 1
              ;;
          esac
          printf '%s (#%s)\n' "$PR_TITLE" "$PR_NUMBER" > "$RUNNER_TEMP/subject.txt"
          uvx pre-commit@{{ pre_commit_version }} run --hook-stage commit-msg \
            --commit-msg-filename "$RUNNER_TEMP/subject.txt"
