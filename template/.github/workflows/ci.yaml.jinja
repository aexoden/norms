# SPDX-License-Identifier: {{ license }}
# SPDX-FileCopyrightText: {{ copyright_year }} {{ author_name }} <{{ author_email }}>
{%- macro checkout() %}
      - name: Checkout repository
        uses: actions/checkout@{{ action_checkout }}
        with:
          persist-credentials: false
{%- endmacro %}
{#- Jobs that install nothing, the gate, markdownlint and zizmor, run on ubuntu-slim.
    Jobs that compile, type check or run tests get 30 minutes, the others 10. #}
{%- macro job(id, name, dir, runner='ubuntu-latest', timeout=10) %}
  {{ id }}:
    name: {{ name }}
    runs-on: {{ runner }}
    timeout-minutes: {{ timeout }}
    permissions:
      contents: read
{%- if dir not in ['', '.'] %}
    defaults:
      run:
        working-directory: {{ dir }}
{%- endif %}
    steps:
{{- checkout() }}
{%- endmacro %}
{%- macro setup_rust() %}

      - name: Install Rust toolchain
        uses: actions-rust-lang/setup-rust-toolchain@{{ action_setup_rust_toolchain }}
{%- if rust_prefix %}
        with:
          cache-workspaces: {{ rust_dir }} -> target
{%- endif %}
{%- endmacro %}
{%- macro setup_uv(sync=true, python='') %}

      - name: Install uv
        uses: astral-sh/setup-uv@{{ action_setup_uv }}
        with:
{%- if python %}
          python-version: "{{ python }}"
{%- endif %}
          version: "{{ uv_version }}"
{%- if python_prefix %}
          working-directory: {{ python_dir }}
{%- endif %}
{%- if sync %}

      - name: Install dependencies
        run: uv sync --locked
{%- endif %}
{%- endmacro %}
{%- macro setup_pnpm() %}

      - name: Install pnpm, Node.js and dependencies
        uses: pnpm/setup@{{ action_setup_pnpm }}
{%- if typescript_prefix %}
        with:
          working-directory: {{ typescript_dir }}
{%- endif %}
{%- endmacro %}
{%- set jobs = ['markdownlint', 'pre-commit', 'reuse', 'zizmor'] %}
{%- if 'rust' in languages %}{% set jobs = jobs + ['cargo-deny', 'cargo-lock', 'cargo-test', 'clippy', 'rustfmt'] %}{% endif %}
{%- if 'python' in languages %}{% set jobs = jobs + ['mypy', 'pytest', 'ruff-check', 'ruff-format', 'uv-lock'] %}{% endif %}
{%- if 'typescript' in languages %}{% set jobs = jobs + ['eslint', 'pnpm-peer-dependencies', 'prettier', 'tsc', 'vite-build', 'vitest'] %}{% endif %}
{#- The pre-commit job skips the hooks that have a job of their own, the hook for
    markdownlint being markdownlint-cli2, and pnpm-lock, since pnpm/setup installs
    with a frozen lock file. #}
{%- set skip = jobs | reject('in', ['markdownlint', 'pre-commit']) | list + ['markdownlint-cli2'] %}
{%- if 'typescript' in languages %}{% set skip = skip + ['pnpm-lock'] %}{% endif %}
{#- Libraries also test the oldest versions they support, in CI only. #}
{%- if project_type == 'library' and 'rust' in languages %}{% set jobs = jobs + ['msrv'] %}{% endif %}
{%- if project_type == 'library' and 'python' in languages %}{% set jobs = jobs + ['pytest-min-python'] %}{% endif %}

name: CI

on:
  push:
    branches: [dev, main]
  pull_request:

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

permissions: {}

jobs:
  ci-success:
    name: CI success
    if: always()
    needs: [{{ jobs | sort | join(', ') }}]
    runs-on: ubuntu-slim
    timeout-minutes: 10
    permissions: {}
    steps:
      - name: Fail unless every job succeeded
        if: contains(needs.*.result, 'failure') || contains(needs.*.result, 'cancelled') || contains(needs.*.result, 'skipped')
        run: exit 1
{{ job('markdownlint', 'Lint Markdown with markdownlint', '', 'ubuntu-slim') }}

      - name: Lint Markdown with markdownlint
        uses: DavidAnson/markdownlint-cli2-action@{{ action_markdownlint_cli2 }}
        with:
          globs: '**/*.md'
{{ job('pre-commit', 'Run the remaining pre-commit hooks', '') }}

      - name: Install uv
        uses: astral-sh/setup-uv@{{ action_setup_uv }}
        with:
          enable-cache: false
          version: "{{ uv_version }}"

      - name: Run the hooks that have no job of their own
        env:
          SKIP: {{ skip | sort | join(',') }}
        run: uvx pre-commit@{{ pre_commit_version }} run --all-files --show-diff-on-failure
{{ job('reuse', 'Check REUSE compliance', '') }}

      - name: Check REUSE compliance
        uses: fsfe/reuse-action@{{ action_reuse }}
{{ job('zizmor', 'GitHub Actions security analysis with zizmor 🌈', '', 'ubuntu-slim') }}

      - name: Run zizmor 🌈
        uses: zizmorcore/zizmor-action@{{ action_zizmor }}
        with:
          advanced-security: false
          annotations: true
          persona: pedantic
{%- if 'rust' in languages %}
{{ job('cargo-deny', 'Run cargo-deny check', '') }}

      - name: Run cargo-deny
        uses: EmbarkStudios/cargo-deny-action@{{ action_cargo_deny }}
        with:
          arguments: --workspace --all-features
          command: check -D warnings bans licenses sources
{%- if rust_prefix %}
          manifest-path: {{ rust_prefix }}Cargo.toml
{%- endif %}
{{ job('cargo-lock', 'Check that Cargo.lock is up to date', rust_dir) }}

      - name: Install Rust toolchain
        uses: actions-rust-lang/setup-rust-toolchain@{{ action_setup_rust_toolchain }}
        with:
          cache: false

      - name: Check that Cargo.lock is up to date
        run: cargo update --workspace --locked
{{ job('cargo-test', 'Run Rust tests', rust_dir, timeout=30) }}
{{- setup_rust() }}

      - name: Run Rust tests
        run: cargo test --workspace --all-features
{{ job('clippy', 'Lint Rust code with Clippy', rust_dir, timeout=30) }}
{{- setup_rust() }}

      - name: Lint Rust code with Clippy
        run: cargo clippy --workspace --all-targets --all-features -- -D warnings
{%- if project_type == 'library' %}
{{ job('msrv', 'Check the minimum supported Rust version', rust_dir, timeout=30) }}

      - name: Install the minimum supported Rust toolchain
        uses: actions-rust-lang/setup-rust-toolchain@{{ action_setup_rust_toolchain }}
        with:
{%- if rust_prefix %}
          cache-workspaces: {{ rust_dir }} -> target
{%- endif %}
          toolchain: "{{ rust_msrv }}"

      # Development dependencies may need a newer Rust, so only the library is checked.
      - name: Check the library with the minimum supported Rust version
        run: cargo check --workspace --all-features --locked
{%- endif %}
{{ job('rustfmt', 'Check Rust code formatting', '') }}

      - name: Install Rust toolchain
        uses: actions-rust-lang/setup-rust-toolchain@{{ action_setup_rust_toolchain }}
        with:
          cache: false

      - name: Check Rust code formatting
        uses: actions-rust-lang/rustfmt@{{ action_rustfmt }}
{%- if rust_prefix %}
        with:
          manifest-path: {{ rust_prefix }}Cargo.toml
{%- endif %}
{%- endif %}
{%- if 'python' in languages %}
{{ job('mypy', 'Type check Python code with mypy', python_dir, timeout=30) }}
{{- setup_uv() }}

      - name: Type check Python code with mypy
        run: uv run mypy .
{{ job('pytest', 'Run Python tests', python_dir, timeout=30) }}
{{- setup_uv() }}

      - name: Run Python tests
        run: uv run pytest --cov=src/{{ python_package }} --cov-report=term-missing
{%- if project_type == 'library' %}
{{ job('pytest-min-python', 'Run Python tests on the oldest supported Python', python_dir, timeout=30) }}
{{- setup_uv(python=python_min_version) }}

      - name: Run Python tests
        run: uv run pytest --cov=src/{{ python_package }} --cov-report=term-missing
{%- endif %}
{{ job('ruff-check', 'Lint Python code with Ruff', python_dir) }}
{{- setup_uv() }}

      - name: Lint Python code with Ruff
        run: uv run ruff check
{{ job('ruff-format', 'Check Python code formatting', python_dir) }}
{{- setup_uv() }}

      - name: Check Python code formatting
        run: uv run ruff format --check
{{ job('uv-lock', 'Check that uv.lock is up to date', python_dir) }}
{{- setup_uv(sync=false) }}

      - name: Check that uv.lock is up to date
        run: uv lock --check
{%- endif %}
{%- if 'typescript' in languages %}
{{ job('eslint', 'Lint TypeScript code with ESLint', typescript_dir, timeout=30) }}
{{- setup_pnpm() }}

      - name: Lint TypeScript code with ESLint
        run: pnpm exec eslint . --max-warnings 0
{{ job('pnpm-peer-dependencies', 'Check pnpm peer dependencies', typescript_dir) }}
{{- setup_pnpm() }}

      - name: Check pnpm peer dependencies
        run: pnpm peers check
{{ job('prettier', 'Check TypeScript code formatting', typescript_dir) }}
{{- setup_pnpm() }}

      - name: Check formatting with Prettier
        run: pnpm exec prettier --check .
{{ job('tsc', 'Type check TypeScript code', typescript_dir, timeout=30) }}
{{- setup_pnpm() }}

      - name: Type check TypeScript code
        run: pnpm exec tsc -b --noEmit
{{ job('vite-build', 'Build the TypeScript application with Vite', typescript_dir, timeout=30) }}
{{- setup_pnpm() }}

      - name: Build the TypeScript application with Vite
        run: pnpm exec vite build
{{ job('vitest', 'Run TypeScript tests', typescript_dir, timeout=30) }}
{{- setup_pnpm() }}

      - name: Run TypeScript tests
        run: pnpm exec vitest run
{%- endif %}
